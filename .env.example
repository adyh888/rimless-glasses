# 部署到 1Panel / 服务器时复制为 .env 并修改

# JWT 签名密钥 —— 必须改成一段随机长字符串，泄漏会导致所有登录态被伪造
# 生成方法（终端执行）：  openssl rand -hex 32
NUXT_JWT_SECRET=please-change-me-to-a-long-random-string

# 公开的站点名（可选）
NUXT_PUBLIC_SITE_NAME=清透视界

# ===== uniCloud 迁移相关（阶段 0 起新增） =====

# Nuxt 客户端调用 uniCloud URL 化网关的基址。
# 三家分别复制为 .env.production.aliyun / .env.production.tcb / .env.production.alipay 后填入真实域名。
# 域名形如：https://your-space.bspapp.com  /  https://xxx.cloudbasefunction.cn  /  https://xxx.cloudapp.tencentcs.com
NUXT_PUBLIC_CLOUD_BASE=

# 仅 scripts/migrate-to-unicloud.ts 使用（阶段 1 数据导入）。
UNICLOUD_PROVIDER=aliyun
UNICLOUD_SPACE_ID=
UNICLOUD_CLIENT_SECRET=
UNICLOUD_ENDPOINT=
